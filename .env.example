# Copy to .env:  cp .env.example .env
# docker compose works without .env too (dev defaults are in docker-compose.yml).

# --- Local run without Docker (uvicorn on your machine) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/delivery_hub
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

ACCESS_TOKEN_EXPIRE_MINUTES=30
CACHE_TTL_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=900
LOG_LEVEL=INFO

# Created by `python -m app.scripts.seed`
ADMIN_PHONE=+70000000000
ADMIN_PASSWORD=admin12345
